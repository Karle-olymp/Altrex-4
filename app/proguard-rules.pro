# [ALTREX] R8 rules of the release build (minify + resource shrinking).
#
# Most libraries ship their own rules inside the AAR/JAR ("consumer rules", merged automatically):
# Gson (gson.pro), Moshi (moshi.pro + one rule file per @JsonClass generated by moshi-kotlin-codegen),
# kotlinx.serialization, kotlinx.coroutines, kotlin-reflect, Ktor (ktor.pro), Dagger/Hilt, AndroidX
# (Compose, DataStore, WorkManager, Lifecycle...), ML Kit GenAI, Play Services OSS licenses and
# PdfBox-Android. Manifest components (activities, services, receivers, providers) are kept by the
# rules aapt2 writes. The rules below cover what nobody ships: native code (JNI), reflection done
# by LiteRT-LM and our own reflection/serialization. Each block says why it is needed.
# The full merged set is in app/build/outputs/mapping/release/configuration.txt after a build.

# ---------------------------------------------------------------------------------------------
# Readable crash traces. Class and method names are obfuscated and files are all called
# "SourceFile", but line numbers stay: decode a trace with the mapping.txt of the same build (see docs/STABILISATION.md,
# "Lire une trace de plantage d'un APK release").
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# Generic signatures and annotations, read at runtime by Gson (List<T> fields), kotlin-reflect
# (LiteRT-LM tools) and Moshi.
-keepattributes Signature,InnerClasses,EnclosingMethod,RuntimeVisibleAnnotations,RuntimeVisibleParameterAnnotations,AnnotationDefault

# ---------------------------------------------------------------------------------------------
# LiteRT-LM (com.google.ai.edge.litertlm): the AAR ships NO consumer rules. liblitertlm_jni.so
# implements LiteRtLmJni's native methods and, from C++, creates and reads Kotlin objects by
# class, field and method name (InputData$Text/Image/Audio, BenchmarkInfo, EmbeddingResponse,
# the JniMessageCallback/JniInferenceCallback interfaces, the *Config classes...). Renaming or
# removing any of them breaks model loading with an error raised in native code.
-keep class com.google.ai.edge.litertlm.** { *; }
-keep interface com.google.ai.edge.litertlm.** { *; }

# LiteRT-LM tools: ReflectionTool reads, with kotlin-reflect, the name of every @Tool function and
# the names and annotations of its parameters (KFunction.name, KParameter.name, callBy), and gives
# them to the model as the tool's schema. Obfuscated names would give the model tools called "a",
# "b"... Keep every ToolSet implementation (tools/*Tool.kt, AgentTools...) with its members and
# its Kotlin metadata (kotlin.Metadata itself is kept by kotlin-reflect's own rules).
-keep class * implements com.google.ai.edge.litertlm.ToolSet { *; }

# ---------------------------------------------------------------------------------------------
# llama.cpp binding (org.nehuatl.llamacpp, our sources + app/src/main/cpp/jni.cpp): JNI functions
# are bound by name (Java_org_nehuatl_llamacpp_LlamaContext_*), and the C++ calls back
# PartialCompletionCallback.onPartialCompletion(Map) by name while streaming tokens.
-keep class org.nehuatl.llamacpp.** { *; }

# Termux terminal emulator: libtermux.so implements com.termux.terminal.JNI's native methods
# (createSubprocess, setPtyWindowSize, waitFor, close...). The AAR ships no rules.
-keep class com.termux.terminal.JNI { *; }

# ---------------------------------------------------------------------------------------------
# Protobuf lite (DataStore files settings.pb, user_data.pb, skills.pb... from app/src/main/proto):
# the lite runtime finds message fields by reflection on their Java names ("theme_", ...).
# protobuf-javalite ships no rules. Renamed fields = DataStore files that no longer parse
# (settings and chats lost or a crash at start).
-keepclassmembers class * extends com.google.protobuf.GeneratedMessageLite { <fields>; }

# ---------------------------------------------------------------------------------------------
# Gson models: the model allowlist (data/ModelAllowlist.kt), the featured skills list
# (data/SkillAllowlist.kt) and the enums of data/Model.kt they use. gson.pro keeps only the fields
# annotated with @SerializedName; these classes are kept whole so that every field, constructor
# and enum constant Gson fills by reflection is still there.
-keep class com.google.ai.edge.gallery.data.ModelAllowlist { *; }
-keep class com.google.ai.edge.gallery.data.AllowedModel { *; }
-keep class com.google.ai.edge.gallery.data.DefaultConfig { *; }
-keep class com.google.ai.edge.gallery.data.SocModelFile { *; }
-keep class com.google.ai.edge.gallery.data.NamedDeviceGroup { *; }
-keep class com.google.ai.edge.gallery.data.DeviceRequirements { *; }
-keep class com.google.ai.edge.gallery.data.SkillAllowlist { *; }
-keep class com.google.ai.edge.gallery.data.AllowedSkill { *; }
-keep enum com.google.ai.edge.gallery.data.ModelCapability { *; }
-keep enum com.google.ai.edge.gallery.data.RuntimeType { *; }
# Note: ArgoraManifest (argora-manifest.json) is parsed with org.json by hand: no rule needed.

# ---------------------------------------------------------------------------------------------
# WebView bridges called from JavaScript by name: the skills WebView (AiEdgeGallery.onResultReady
# in AgentChatScreen.kt) and the code runner (AltrexOut in ui/common/coderunner/CodeRunner.kt).
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}

# ---------------------------------------------------------------------------------------------
# Enums: R8 keeps the string returned by name(), so enums saved by name (preferences, protos,
# Moshi/Gson) keep working; values()/valueOf() are kept by proguard-android-optimize.txt.

# ---------------------------------------------------------------------------------------------
# Missing classes reported by R8 (app/build/outputs/mapping/release/missing_rules.txt).
# PdfBox-Android: JPEG 2000 images need the optional jp2-android library (com.gemalto.jp2), which
# Altrex does not ship; the debug build lacks it too. Only text is read from PDFs.
-dontwarn com.gemalto.jp2.JP2Decoder
