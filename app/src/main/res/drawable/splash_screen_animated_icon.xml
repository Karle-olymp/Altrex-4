<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
  <aapt:attr name="android:drawable">
    <vector
        android:width="432dp"
        android:height="432dp"
        android:viewportWidth="432"
        android:viewportHeight="432">
      <group
          android:name="badge"
          android:pivotX="216"
          android:pivotY="216"
          android:scaleX="0.6"
          android:scaleY="0.6">
        <path
            android:name="disc"
            android:fillColor="#FF0E6BA8"
            android:fillAlpha="0"
            android:pathData="M216,106a110,110 0,1 1,0 220a110,110 0,1 1,0 -220z" />
        <group
            android:translateX="86.4"
            android:translateY="88.8"
            android:scaleX="2.4"
            android:scaleY="2.4">
          <path
              android:name="mark"
              android:fillColor="#FFFFFFFF"
              android:fillAlpha="0"
              android:fillType="evenOdd"
              android:pathData="M54,28L76,78L65,78L60.5,67L47.5,67L43,78L32,78ZM54,41L49.5,59L58.5,59Z" />
        </group>
      </group>
    </vector>
  </aapt:attr>
  <target android:name="badge">
    <aapt:attr name="android:animation">
      <set android:ordering="together">
        <objectAnimator
            android:duration="750"
            android:interpolator="@android:interpolator/overshoot"
            android:propertyName="scaleX"
            android:valueFrom="0.6"
            android:valueTo="1"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="750"
            android:interpolator="@android:interpolator/overshoot"
            android:propertyName="scaleY"
            android:valueFrom="0.6"
            android:valueTo="1"
            android:valueType="floatType" />
      </set>
    </aapt:attr>
  </target>
  <target android:name="disc">
    <aapt:attr name="android:animation">
      <objectAnimator
          android:duration="350"
          android:propertyName="fillAlpha"
          android:valueFrom="0"
          android:valueTo="1"
          android:valueType="floatType" />
    </aapt:attr>
  </target>
  <target android:name="mark">
    <aapt:attr name="android:animation">
      <objectAnimator
          android:duration="400"
          android:propertyName="fillAlpha"
          android:startOffset="200"
          android:valueFrom="0"
          android:valueTo="1"
          android:valueType="floatType" />
    </aapt:attr>
  </target>
</animated-vector>